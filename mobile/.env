# Mobile Environment
# EXPO_PUBLIC_ prefix = accessible in code via process.env.EXPO_PUBLIC_*

# Gemini API Key - bạn cũng có thể nhập trực tiếp trong app Settings
EXPO_PUBLIC_GEMINI_API_KEY=

# Backend URL - thay bằng IPv4 của PC khi chạy WiFi/USB
# Chạy: ipconfig  -> tìm dòng "IPv4 Address" của WiFi adapter
EXPO_PUBLIC_BACKEND_URL=http://192.168.1.100:5000
